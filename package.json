{
  "name": "@kimuson/motion-kit",
  "version": "0.2.0",
  "description": "An agent-first framework for programmatic video.",
  "keywords": [
    "agent",
    "animation",
    "cli",
    "ffmpeg",
    "playwright",
    "programmatic-video",
    "react",
    "typescript",
    "video",
    "video-rendering"
  ],
  "homepage": "https://github.com/d-kimuson/motion-kit#readme",
  "bugs": {
    "url": "https://github.com/d-kimuson/motion-kit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-kimuson/motion-kit.git"
  },
  "bin": {
    "motion-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/index.md",
    "docs/guide",
    "THIRD_PARTY_LICENSES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/preview-css.ts && tsdown && pnpm third-party:licenses",
    "prelint": "pnpm build",
    "pretypecheck": "pnpm build",
    "pretest": "pnpm build",
    "lint": "run-p lint:*",
    "lint:oxlint": "oxlint --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "lint:publint": "publint --pack=pnpm",
    "lint:attw": "attw --pack --profile esm-only",
    "lint:oxfmt": "pnpm fix:oxfmt --check",
    "lint:licenses": "node scripts/check-licenses.ts",
    "lint:third-party": "node scripts/third-party-licenses.ts --check",
    "third-party:licenses": "node scripts/third-party-licenses.ts",
    "lint:tsconfig": "node scripts/check-tsconfig-coverage.ts",
    "lint:lean-spec": "node scripts/lean-spec.ts check src/core",
    "fix": "run-p fix:*",
    "fix:oxlint": "pnpm lint:oxlint --fix",
    "fix:oxfmt": "oxfmt --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p . --noEmit",
    "preversion": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test": "vitest run",
    "spike:motion": "vitest run --config spikes/a-motion/vitest.config.ts --reporter=verbose --silent=false",
    "spike:three": "vitest run --config spikes/b-r3f/vitest.config.ts --reporter=verbose --silent=false",
    "spike:three:flags": "node spikes/b-r3f/run-flags.ts",
    "spike:clock": "vitest run --config spikes/c-clock/vitest.config.ts --reporter=verbose --silent=false",
    "spike:assets": "vitest run --config spikes/d-assets/vitest.config.ts --reporter=verbose --silent=false",
    "schema:cli-output": "node scripts/generate-cli-output-schema.ts",
    "lean:build": "lake build",
    "lean:doc": "node scripts/lean-spec.ts doc src/core",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "commander": "15.0.0",
    "playwright": "1.64.1",
    "vite": "7.3.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@base-ui/react": "1.9.0",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/oxide": "4.3.3",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/browser-playwright": "5.0.5",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clean-pkg-json": "2.0.0",
    "clsx": "2.1.1",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "lucide-react": "1.65.0",
    "motion": "14.6.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "tsdown": "0.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@react-three/fiber": "^9.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
