{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    // Ignore Linter
    "noImplicitReturns": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,

    // Module Resolution
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,

    // Development resolution: the repository's own tests import the public package name, which
    // resolves to src/ so that nominal (symbol-branded) types and module-level singletons stay
    // identical between package-name and relative imports. The published package resolves the same
    // name to dist/ through `package.json#exports`; scripts/check-browser-graph.test.ts verifies
    // that built layout. See docs/contexts/render/CONTEXT.md.
    "paths": {
      "@kimuson/motion-kit": ["./src/index.ts"],
      "@kimuson/motion-kit/render": ["./src/render/index.ts"],
      "@kimuson/motion-kit/agent": ["./src/agent/cli-output.ts"]
    },

    // TypeChecking
    "exactOptionalPropertyTypes": false,
    "allowJs": true,
    // TypeScript 7 does not pick up @types/* automatically; scripts/ and spec/ use Node.js APIs.
    "types": ["node"],

    // transpile
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "target": "es2024",
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"]
  },
  "include": [
    "*.ts",
    "src",
    "spec",
    "scripts",
    "configs",
    "spikes/a-motion",
    "spikes/b-r3f",
    "spikes/c-clock",
    "spikes/d-assets",
    ".agents/**/*.ts"
  ]
}
